{
  "app": "تقارير",
  "version": "0.7.1",
  "phase": "Phase 1-C1 Fix 1 - Editorial Report Rebuild",
  "releaseName": "Adaptive Deep Educational Analytics Engine",
  "buildType": "static-github-pages-plus-supabase-edge-function",
  "supportedInputs": {
    "table": [
      "csv",
      "tsv",
      "txt",
      "xlsx",
      "xlsm"
    ],
    "document": [
      "docx",
      "pdf-text-layer"
    ],
    "aiVisual": [
      "png",
      "jpg",
      "jpeg",
      "webp",
      "scanned-pdf-first-pages"
    ],
    "manualFallback": [
      "image",
      "scanned-pdf"
    ]
  },
  "analysisArchitecture": {
    "sharedInfrastructure": [
      "document-ingestion",
      "ministry-excel-normalization",
      "data-quality-validation",
      "form-recognition",
      "evidence-contract",
      "report-rendering"
    ],
    "specializedAnalyzers": [
      "single-subject-results",
      "assessment-component-results",
      "level-distribution",
      "cross-subject-profile",
      "supervision-indicators",
      "student-work-indicators",
      "supervision-narrative",
      "survey-and-attitudes",
      "training-needs",
      "program-and-initiative-evaluation",
      "behavior-attendance-and-discipline",
      "adaptive-new-form-contract"
    ],
    "routingRule": "form-type-routes-to-its-own-analysis-family-without-forcing-a-unified-procedure"
  },
  "features": [
    "adaptive-analysis-router",
    "specialized-form-analyzers",
    "deep-descriptive-statistics",
    "quartiles-percentiles-and-outlier-analysis",
    "distribution-shape-skewness-kurtosis-and-variation",
    "mastery-sensitivity-and-intervention-segmentation",
    "cross-group-and-cross-subject-comparison",
    "radar-pareto-gap-priority-and-pdca-tools",
    "narrative-evidence-quality-analysis",
    "section-alignment-duplication-contradiction-and-date-checks",
    "type-specific-diagnostic-sections",
    "multi-layer-evidence-linked-findings",
    "multi-action-improvement-plan",
    "baseline-follow-up-remeasurement-monitoring-cycle",
    "additional-data-requests",
    "dynamic-new-form-contract-proposal",
    "gemini-deep-type-aware-analysis",
    "server-side-evidence-reference-validation",
    "independent-deep-official-report",
    "multiple-print-safe-charts",
    "ministry-excel-normalization-engine",
    "merged-cell-aware-header-reconstruction",
    "personal-field-masking-before-ai",
    "local-analysis-fallback",
    "json-export"
  ],
  "runtime": {
    "frontend": "GitHub Pages static site",
    "aiGateway": "Supabase Edge Function",
    "aiProvider": "Google Gemini API",
    "defaultModel": "gemini-2.5-flash",
    "pdfjs": "6.2.108 via jsDelivr, loaded only when PDF is opened"
  },
  "security": {
    "geminiKeyInBrowser": false,
    "originAllowlist": true,
    "sharedAccessCode": true,
    "personalFieldMaskingDefault": true,
    "evidenceReferencesValidatedServerSide": true
  },
  "acceptanceCoverage": {
    "analysisFamilies": 11,
    "adaptiveFallback": "new-form profiling, relevant exploratory analysis, data requests and contract proposal",
    "scoreReports": "10 metrics, 4 charts, 5 findings, 6 quality tools, 4 intervention actions",
    "levelDistribution": "group comparison, upper/lower levels, gaps and priorities",
    "crossSubject": "subject ranking, comprehensive/specialized risk and descriptive relationships",
    "supervisionIndicators": "domains, gap, radar, pareto, priority and PDCA",
    "studentWork": "feedback, differentiation, progress, learning skills and product quality",
    "supervisionNarrative": "evidence strength, alignment, duplication, contradictions, dates and actionability",
    "survey": "Likert profile, item gaps, Pareto and conditional internal consistency",
    "trainingNeeds": "importance x performance gap x beneficiary reach with impact follow-up",
    "programEvaluation": "implementation, outcomes, impact, gap, PDCA and sustainability",
    "behaviorAttendance": "Pareto, time trend, repeated cases and early-warning logic"
  },
  "notYetEnabled": [
    "direct-word-export",
    "cloud-project-storage",
    "user-accounts",
    "role-based-access-control",
    "durable-rate-limiting",
    "saved-dynamic-form-registry",
    "direct-rpt-reading",
    "legacy-doc-and-xls-reading"
  ]
}