{
  "app": "تقارير",
  "version": "1.0.3",
  "phase": "Phase 2-A - AI-Native Analytical Core",
  "releaseName": "AI-Native Analytical Core",
  "buildType": "static-github-pages-plus-supabase-edge-function",
  "supportedInputs": {
    "table": [
      "csv",
      "tsv",
      "txt",
      "xlsx",
      "xlsm"
    ],
    "document": [
      "docx",
      "pdf-text-layer"
    ],
    "aiVisual": [
      "png",
      "jpg",
      "jpeg",
      "webp",
      "scanned-pdf-first-pages"
    ],
    "manualFallback": [
      "image",
      "scanned-pdf"
    ]
  },
  "analysisArchitecture": {
    "sharedInfrastructure": [
      "document-ingestion",
      "ministry-excel-normalization",
      "data-quality-validation",
      "form-recognition",
      "evidence-contract",
      "report-rendering"
    ],
    "specializedAnalyzers": [
      "single-subject-results",
      "assessment-component-results",
      "level-distribution",
      "cross-subject-profile",
      "supervision-indicators",
      "student-work-indicators",
      "supervision-narrative",
      "survey-and-attitudes",
      "training-needs",
      "program-and-initiative-evaluation",
      "behavior-attendance-and-discipline",
      "adaptive-new-form-contract"
    ],
    "canonicalContract": "local-calculations-are-authoritative-ai-owns-educational-analysis",
    "aiContribution": "Gemini is the primary educational analyst and creates diagnosis, findings, hypotheses, interventions and monitoring from verified evidence; it does not edit local prose templates",
    "reconciliation": "server and client validate evidence references and minimum analytical completeness before any result is shown",
    "routingRule": "form type shapes the evidence dossier and analytical lens, but the AI chooses depth and item counts according to the actual evidence"
  },
  "features": [
    "adaptive-analysis-router",
    "specialized-form-analyzers",
    "deep-descriptive-statistics",
    "mastery-metrics-single-source-of-truth",
    "chart-completeness-guard",
    "print-safe-a4-and-letter-reporting",
    "canonical-deterministic-analysis-contract",
    "stable-target-identifiers",
    "server-side-target-validation",
    "server-side-evidence-reference-validation",
    "single-effective-analysis-model",
    "late-response-guard",
    "fingerprint-based-local-ai-result-cache",
    "compact-type-aware-ai-dossier",
    "visible-stage-timing-and-payload-size",
    "bounded-gemini-thinking-budget",
    "personal-field-masking-before-ai",
    "non-retryable-configuration-guard",
    "per-tool-quality-payload",
    "local-safe-quality-fallback",
    "fast-model-default-with-optional-override",
    "ai-primary-educational-analysis",
    "evidence-only-local-engine",
    "variable-depth-ai-diagnosis",
    "fact-inference-hypothesis-separation",
    "server-validated-evidence-references",
    "client-validated-primary-analysis",
    "no-template-fallback-presented-as-deep-analysis",
    "context-specific-interventions",
    "single-primary-analysis-request",
    "compact-ai-decision-units",
    "server-side-report-shape-expansion",
    "fresh-primary-analysis-on-every-run",
    "controlled-primary-thinking-level",
    "schema-enforced-output-cardinality",
    "max-token-rescue-path",
    "usage-token-diagnostics"
  ],
  "runtime": {
    "frontend": "GitHub Pages static site",
    "aiGateway": "Supabase Edge Function",
    "aiProvider": "Google Gemini API",
    "defaultModel": "gemini-3.5-flash",
    "classifierModel": "gemini-3.5-flash-lite",
    "enrichmentOperation": "analyze_primary",
    "legacyAnalyzeThinkingBudget": 1024,
    "classificationThinkingBudget": 0,
    "reconciliationContractVersion": "6.2.0",
    "edgeFunctionVersion": "0.13.3",
    "fastEnhancementModel": "gemini-3.5-flash-lite",
    "fastEnhancementThinkingBudget": 192,
    "fastEnhancementMaxOutputTokens": 2600,
    "fastEnhancementClientTimeoutMs": 16000,
    "primaryAnalysisMaxOutputTokens": 8192,
    "primaryAnalysisClientTimeoutMs": 45000,
    "primaryAnalysisThinkingLevel": "low",
    "primaryRescueModel": "gemini-3.5-flash-lite",
    "primaryRescueThinkingLevel": "minimal",
    "primaryRescueMaxOutputTokens": 6144
  },
  "security": {
    "geminiKeyInBrowser": false,
    "originAllowlist": true,
    "sharedAccessCode": true,
    "personalFieldMaskingDefault": true,
    "evidenceReferencesValidatedServerSide": true,
    "targetIdsValidatedServerSide": true,
    "deterministicCountsLockedClientSide": false,
    "primaryAnalysisRequiredForReport": true
  },
  "acceptanceCoverage": {
    "analysisFamilies": 11,
    "primaryAiOwnership": "diagnosis, findings, hypotheses, interventions and monitoring are generated by Gemini from evidence rather than local prose templates",
    "localOwnership": "data extraction, validation, calculations, metrics, charts and evidence references",
    "evidenceGate": "unknown evidence references are removed server-side and client-side",
    "minimumResult": "at least 2 evidence-backed AI decision units and 1 intervention; the server expands them into the report shape without inventing analysis",
    "variableCounts": "no locked count for diagnostics, findings, interventions or monitoring",
    "failureBehavior": "no official report is shown when the primary AI analysis fails",
    "cacheBehavior": "primary educational analysis is not reused; every run requests a fresh evidence-grounded reading"
  },
  "performance": {
    "scoreContextRows": 24,
    "specializedTableContextRows": 60,
    "newTypeContextRows": 60,
    "narrativeContextLines": 120,
    "resultsPresentation": "results appear only after the primary AI analysis passes evidence validation",
    "networkRequestsPerAnalysis": "1 normally; 2 only when the first output is incomplete or invalid",
    "clientTimeoutMs": 45000,
    "payloadAcceptanceLimitChars": 90000,
    "latencyStrategy": "Gemini 3.5 Flash with low thinking, schema-enforced item limits, 8192 output headroom, and one minimal-thinking rescue only after an incomplete response"
  },
  "backwardCompatibility": {
    "databaseChanges": false,
    "newSecretsRequired": false,
    "currentFrontendOperation": "analyze_primary",
    "legacyEnhanceFastOperation": "retained server-side for old clients but unused by v1.0.3",
    "classificationAndVision": "retained"
  },
  "notYetEnabled": [
    "direct-word-export",
    "cloud-project-storage",
    "user-accounts",
    "role-based-access-control",
    "durable-rate-limiting",
    "saved-dynamic-form-registry",
    "direct-rpt-reading",
    "legacy-doc-and-xls-reading"
  ]
}
