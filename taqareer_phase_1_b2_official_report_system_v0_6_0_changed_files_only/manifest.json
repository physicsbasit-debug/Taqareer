{
  "app": "تقارير",
  "version": "0.6.0",
  "phase": "1-B2",
  "releaseName": "Independent Official A4 Report System",
  "buildType": "static-github-pages-plus-supabase-edge-function",
  "supportedInputs": {
    "table": [
      "csv",
      "tsv",
      "txt",
      "xlsx",
      "xlsm"
    ],
    "document": [
      "docx",
      "pdf-text-layer"
    ],
    "aiVisual": [
      "png",
      "jpg",
      "jpeg",
      "webp",
      "scanned-pdf-first-pages"
    ],
    "manualFallback": [
      "image",
      "scanned-pdf"
    ]
  },
  "features": [
    "ministry-excel-normalization-engine",
    "merged-cell-aware-header-reconstruction",
    "spacer-row-and-column-removal",
    "multi-row-header-detection",
    "rtl-logical-column-reordering",
    "report-metadata-separation",
    "required-field-completeness",
    "local-semantic-form-recognition",
    "gemini-hybrid-form-verification",
    "classification-provenance",
    "deterministic-local-analysis",
    "live-ai-educational-interpretation",
    "vision-table-and-narrative-extraction",
    "evidence-reference-contract",
    "server-side-evidence-reference-validation",
    "quality-tool-selection",
    "measurable-improvement-plan",
    "personal-field-masking-before-ai",
    "local-analysis-fallback",
    "json-export",
    "independent-official-report-window",
    "three-page-a4-report-layout",
    "human-readable-evidence-references",
    "print-safe-charts-and-tables",
    "dashboard-print-blocker"
  ],
  "runtime": {
    "frontend": "GitHub Pages static site",
    "aiGateway": "Supabase Edge Function",
    "aiProvider": "Google Gemini API",
    "defaultModel": "gemini-2.5-flash",
    "pdfjs": "6.2.108 via jsDelivr, loaded only when PDF is opened"
  },
  "security": {
    "geminiKeyInBrowser": false,
    "originAllowlist": true,
    "sharedAccessCode": true,
    "personalFieldMaskingDefault": true
  },
  "acceptanceFixtures": {
    "ministryExcel": "aaaa.xlsx analyzed as 268 records and 5 logical fields",
    "supervisionDocx": "1111111.docx analyzed as supervision narrative"
  },
  "notYetEnabled": [
    "direct-word-export",
    "cloud-project-storage",
    "user-accounts",
    "role-based-access-control",
    "durable-rate-limiting",
    "saved-dynamic-form-registry",
    "direct-rpt-reading",
    "legacy-doc-and-xls-reading"
  ]
}
